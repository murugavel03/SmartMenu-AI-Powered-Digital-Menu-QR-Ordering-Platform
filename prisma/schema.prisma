// SmartMenu Prisma Schema
// Multi-tenant SaaS for restaurants

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}













model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String  @default("CUSTOMER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts         Account[]
  sessions         Session[]
  staffProfile     RestaurantStaff?
  ownedRestaurants Restaurant[] @relation("RestaurantOwner")
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  @@unique([identifier, token])
}

model Restaurant {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  logo        String?
  coverImage  String?
  phone       String?
  email       String?
  address     String?
  city        String?
  country     String?
  isActive    Boolean  @default(true)
  isOpen      Boolean  @default(true)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner         User    @relation("RestaurantOwner", fields: [ownerId], references: [id])
  staff         RestaurantStaff[]
  categories    Category[]
  menuItems     MenuItem[]
  tables        Table[]
  qrCodes       QRCode[]
  orders        Order[]
  settings      RestaurantSettings?
  menuImports   MenuImport[]
  notifications Notification[]
  @@index([slug])
  @@index([ownerId])
}

model RestaurantStaff {
  id           String   @id @default(cuid())
  restaurantId String
  userId       String   @unique
  role         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  waitedOrders Order[]    @relation("WaiterOrders")
  @@index([restaurantId])
  @@index([userId])
}

model RestaurantSettings {
  id                       String    @id @default(cuid())
  restaurantId             String    @unique
  currency                 String    @default("INR")
  currencySymbol           String    @default("Rs.")
  taxPercentage            Float     @default(0)
  serviceCharge            Float     @default(0)
  gstEnabled               Boolean   @default(false)
  gstNumber                String?
  theme                    String @default("MODERN")
  primaryColor             String    @default("#f97316")
  accentColor              String    @default("#ea580c")
  allowSpecialInstructions Boolean   @default(true)
  requireCustomerName      Boolean   @default(false)
  requireCustomerPhone     Boolean   @default(false)
  estimatedPrepTime        Int       @default(20)
  openingHours             String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Category {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  image        String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]
  @@index([restaurantId])
  @@index([restaurantId, sortOrder])
}

model MenuItem {
  id            String     @id @default(cuid())
  restaurantId  String
  categoryId    String
  name          String
  description   String?
  price         Float
  discountPrice Float?
  image         String?
  isVegetarian  Boolean    @default(false)
  isVegan       Boolean    @default(false)
  spiceLevel    String @default("NONE")
  prepTime      Int?
  isAvailable   Boolean    @default(true)
  isFeatured    Boolean    @default(false)
  isPopular     Boolean    @default(false)
  allergens     String?
  tags          String?
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  restaurant  Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category    Category         @relation(fields: [categoryId], references: [id])
  variants    MenuItemVariant[]
  addons      MenuItemAddon[]
  images      MenuItemImage[]
  orderItems  OrderItem[]
  importItems MenuImportItem[]
  @@index([restaurantId])
  @@index([categoryId])
  @@index([restaurantId, isAvailable])
}

model MenuItemVariant {
  id         String   @id @default(cuid())
  menuItemId String
  name       String
  price      Float
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  @@index([menuItemId])
}

model MenuItemAddon {
  id         String   @id @default(cuid())
  menuItemId String
  name       String
  price      Float    @default(0)
  isRequired Boolean  @default(false)
  createdAt  DateTime @default(now())
  menuItem        MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItemAddons OrderItemAddon[]
  @@index([menuItemId])
}

model MenuItemImage {
  id         String   @id @default(cuid())
  menuItemId String
  url        String
  altText    String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  @@index([menuItemId])
}

model Table {
  id           String      @id @default(cuid())
  restaurantId String
  name         String
  capacity     Int         @default(4)
  status       String @default("AVAILABLE")
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  qrCode       QRCode?
  orders       Order[]
  @@index([restaurantId])
}

model QRCode {
  id           String   @id @default(cuid())
  restaurantId String
  tableId      String   @unique
  code         String   @unique @default(cuid())
  url          String
  qrImageUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table        Table      @relation(fields: [tableId], references: [id], onDelete: Cascade)
  @@index([restaurantId])
  @@index([code])
}

model Customer {
  id        String   @id @default(cuid())
  name      String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  orders    Order[]
  @@index([phone])
}

model Order {
  id                  String      @id @default(cuid())
  orderNumber         String      @unique
  restaurantId        String
  tableId             String?
  customerId          String?
  waiterId            String?
  status              String @default("PENDING")
  subtotal            Float
  taxAmount           Float       @default(0)
  serviceCharge       Float       @default(0)
  totalAmount         Float
  specialInstructions String?
  estimatedTime       Int?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  restaurant    Restaurant          @relation(fields: [restaurantId], references: [id])
  table         Table?              @relation(fields: [tableId], references: [id])
  customer      Customer?           @relation(fields: [customerId], references: [id])
  waiter        RestaurantStaff?    @relation("WaiterOrders", fields: [waiterId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  notifications Notification[]
  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([orderNumber])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  menuItemId   String
  variantId    String?
  name         String
  variantName  String?
  quantity     Int
  unitPrice    Float
  totalPrice   Float
  instructions String?
  createdAt    DateTime @default(now())
  order    Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem       @relation(fields: [menuItemId], references: [id])
  addons   OrderItemAddon[]
  @@index([orderId])
}

model OrderItemAddon {
  id          String   @id @default(cuid())
  orderItemId String
  addonId     String
  name        String
  price       Float
  createdAt   DateTime @default(now())
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addon       MenuItemAddon @relation(fields: [addonId], references: [id])
  @@index([orderItemId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    String
  note      String?
  createdAt DateTime    @default(now())
  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId])
}

model MenuImport {
  id           String           @id @default(cuid())
  restaurantId String
  fileName     String
  fileUrl      String
  fileType     String
  status       String @default("PENDING")
  aiProvider   String?
  rawData      String?
  errorMessage String?
  publishedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        MenuImportItem[]
  @@index([restaurantId])
}

model MenuImportItem {
  id           String     @id @default(cuid())
  importId     String
  menuItemId   String?
  categoryName String
  name         String
  description  String?
  price        Float?
  isVegetarian Boolean    @default(false)
  spiceLevel   String @default("NONE")
  variants     String?
  addons       String?
  rawData      String?
  isApproved   Boolean    @default(false)
  isDeleted    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  import     MenuImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  menuItem   MenuItem?  @relation(fields: [menuItemId], references: [id])
  @@index([importId])
}

model Notification {
  id           String   @id @default(cuid())
  restaurantId String
  orderId      String?
  type         String
  title        String
  message      String
  isRead       Boolean  @default(false)
  metadata     String?
  createdAt    DateTime @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order        Order?     @relation(fields: [orderId], references: [id])
  @@index([restaurantId])
  @@index([restaurantId, isRead])
}
